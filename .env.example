# Postgres
DATABASE_URL=postgres://localhost:5432/cassie_indexer

# X (Twitter) API v2 — app-only bearer token, used by the collector
X_BEARER_TOKEN=

# OpenAI — available extraction provider
OPENAI_API_KEY=

# DeepSeek — optional extract fallback
DEEPSEEK_API_KEY=

# Google Gemini — optional extract fallback
GEMINI_API_KEY=

# OpenRouter — Jev pre-gate + Qwen extract, route, and plan
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
JEV_MODEL=typesafe/jev-1.13
JEV_PASS_THRESHOLD=0.3
QWEN_MODEL=qwen/qwen3.8-flash

# Definitive Flash — asset discovery and executable route checks
DEFINITIVE_API_KEY=

# Polygon.io — equity prices (live + intraday history) and reference data
POLYGON_API_KEY=

# Hyperliquid + Polymarket public info endpoints need no keys for search/pricing.
# Override only if pointing at non-default environments.
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com

# Pipeline tuning
COLLECT_LOOKBACK_HOURS=24        # first-run backfill window per source
PROCESS_BATCH_SIZE=25            # posts drained per processor run
EXTRACTOR_MODEL=qwen/qwen3.8-flash
